<?xml version="1.0" encoding="UTF-8"?>
<!--
  polar-assets-svc launchd plist for macOS user-mode auto-start.

  Drop at ~/Library/LaunchAgents/polar.assets-svc.plist, then:
    launchctl load -w ~/Library/LaunchAgents/polar.assets-svc.plist

  The plist invokes the wrapper at ~/.local/bin/polar-assets-svc-launch.sh
  which sources per-box secrets from ~/assets-svc.env. Secrets stay out
  of the committed file — see scripts/launchd/assets-svc.env.sample for
  the env file shape.

  See scripts/launchd/setup-assets-svc.sh for a one-shot installer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>polar.assets-svc</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/local/.local/bin/polar-assets-svc-launch.sh</string>
  </array>

  <!-- Auto-start at user login + auto-restart only on non-zero exit
       (`launchctl unload` actually stops assets-svc when an admin
       wants to take it down). ThrottleInterval gives dock time to come
       up before assets-svc loops on /internal/v1/ping errors. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/polar.assets-svc.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/polar.assets-svc.log</string>
</dict>
</plist>
