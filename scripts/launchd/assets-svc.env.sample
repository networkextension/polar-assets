# Per-box secrets for polar-assets-svc. Copy to ~/assets-svc.env and
# chmod 600 — the launchd plist's wrapper sources from there.
#
# Provision the plugin row + capture the plaintext token via
# /admin-plugins.html on dock BEFORE creating this file.
#
# Get POLAR_PLUGIN_TOKEN from dock /admin-plugins.html (plaintext is
# printed ONCE at row creation; rotate via "Rotate key" if lost).

# Dock's HTTP base URL for the /internal/v1/* SDK calls.
export POLAR_DOCK_BASE="http://127.0.0.1:8080"

# Must match the plugin_modules.name row in dock.
export POLAR_PLUGIN_NAME="assets"

# Plaintext token printed ONCE by /admin-plugins.html at row creation.
# After capturing it here, the dock-side hash is the only persistent
# copy — losing this file means rotating via "Rotate key".
export POLAR_PLUGIN_TOKEN=""

# assets-svc's HTTP listen address. nginx proxies the public /v1/* +
# /api/admin/assets-* prefixes here. Keep on 127.0.0.1 — nginx is the
# only public entry.
export POLAR_ASSETS_LISTEN="127.0.0.1:8091"

# Stamped onto plugin_modules.version + /admin-plugins.html.
export POLAR_ASSETS_VERSION="phase2-skeleton"

# Local blob root. P3 will store cached asset blobs under here keyed
# by sha256. This MUST NOT be shared with dock's UPLOAD_DIR —
# assets-svc owns its own filesystem just like every other plugin.
export POLAR_ASSETS_BLOB_DIR="/Users/local/assets-svc-data"

# Bearer required on GET /metrics. Re-use dock's METRICS_TOKEN so
# Prometheus can scrape both with one bearer. Empty = endpoint
# disabled (404).
export POLAR_ASSETS_METRICS_TOKEN=""

# Needed so assets-svc can find brew-installed tools (psql etc) from
# a launchd context that doesn't inherit the operator's PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
